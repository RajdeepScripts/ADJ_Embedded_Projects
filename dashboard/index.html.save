<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Vehicle Event Monitoring Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
/* =========================
   GLOBAL STYLES
========================= */
body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #0b1220;
    color: #eaeaea;
    height: 100vh;
    display: flex;
}

/* =========================
   SIDEBAR MENU
========================= */
.sidebar {
    width: 240px;
    background-color: #111827;
    padding: 20px;
}

.sidebar h2 {
    text-align: center;
    color: #22c55e;
    margin-bottom: 30px;
}

.menu-btn {
    width: 100%;
    padding: 12px;
    margin-bottom: 12px;
    background: none;
    border: 1px solid #1f2937;
    color: #eaeaea;
    cursor: pointer;
    border-radius: 6px;
    font-size: 15px;
}

.menu-btn.active {
    background-color: #22c55e;
    color: #000;
}

/* =========================
   MAIN CONTENT
========================= */
.main {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}

.tab {
    display: none;
}

.tab.active {
    display: block;
}

/* =========================
   EVENTS TAB
========================= */
.event-card {
    background-color: #111827;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 15px;
    border-left: 5px solid #ef4444;
}

.event-card h4 {
    margin: 0 0 5px 0;
}

.event-card p {
    margin: 2px 0;
    color: #9ca3af;
    font-size: 14px;
}

/* =========================
   GRAPHS TAB
========================= */
.graph-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.graph-box {
    background-color: #111827;
    padding: 15px;
    border-radius: 8px;
}

.graph-placeholder {
    height: 280px;
    border: 2px dashed #374151;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 14px;
}

/* =========================
   IMAGES TAB
========================= */
.image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 15px;
}

.image-grid img {
    width: 100%;
    border-radius: 8px;
    border: 2px solid #1f2937;
}
</style>
</head>

<body>

<!-- =========================
     SIDEBAR
========================= -->
<div class="sidebar">
    <h2>DASHBOARD</h2>
    <button class="menu-btn active" onclick="showTab('events')">Events</button>
    <button class="menu-btn" onclick="showTab('graphs')">Graphs</button>
    <button class="menu-btn" onclick="showTab('images')">Images</button>
</div>

<!-- =========================
     MAIN CONTENT
========================= -->
<div class="main">

    <!-- EVENTS TAB -->
    <div id="events" class="tab active">
        <h2>Accelerometer Triggered Events</h2>

        <div class="event-card">
            <h4>High Jerk Detected</h4>
            <p>Time: 14:32:18</p>
            <p>GPS: 28.6139° N, 77.2090° E</p>
        </div>

        <div class="event-card">
            <h4>Sudden Deceleration</h4>
            <p>Time: 14:47:02</p>
            <p>GPS: 28.7041° N, 77.1025° E</p>
        </div>

        <div class="event-card">
            <h4>Track Irregularity</h4>
            <p>Time: 15:01:44</p>
            <p>GPS: 28.5355° N, 77.3910° E</p>
        </div>
    </div>

    <!-- GRAPHS TAB -->
    <div id="graphs" class="tab">
        <h2>Ride Comfort & Speed Analysis</h2>

        <div class="graph-container">
            <div class="graph-box">
                <h3>Ride Comfort Histogram</h3>
                <div class="graph-placeholder">
                    Histogram (Comfort ∝ 1 / Jerk)
                </div>
            </div>

            <div class="graph-box">
                <h3>Speed vs Location Graph</h3>
                <div class="graph-placeholder">
                    Continuous Speed–Location Plot
                </div>
            </div>
        </div>
    </div>

    <!-- IMAGES TAB -->
    <div id="images" class="tab">
        <h2>Captured Images (ESP32-CAM)</h2>

        <div class="image-grid">
            <img src="https://via.placeholder.com/400x250?text=Event+Image+1">
            <img src="https://via.placeholder.com/400x250?text=Event+Image+2">
            <img src="https://via.placeholder.com/400x250?text=Event+Image+3">
            <img src="https://via.placeholder.com/400x250?text=Event+Image+4">
        </div>
    </div>

</div>

<!-- =========================
     JS (TAB CONTROL ONLY)
========================= -->
<script>
function showTab(tabId) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.menu-btn').forEach(b => b.classList.remove('active'));

    document.getElementById(tabId).classList.add('active');
    event.target.classList.add('active');
}
</script>

</body>
</html>
